# Modelo de configuração - NÃO contém senha real.
# 1. Copie:   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
# 2. Troque POSTGRES_PASSWORD por uma senha forte.
# O .env é lido automaticamente pelo docker compose e está no .gitignore.

POSTGRES_DB=achados
POSTGRES_USER=achados_app
POSTGRES_PASSWORD=troque-esta-senha
